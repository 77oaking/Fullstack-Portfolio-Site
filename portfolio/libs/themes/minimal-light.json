      "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "lineHeight": { "tight": 1.15, "normal": 1.55, "relaxed": 1.75 },
      "letterSpacing": { "tight": "-0.015em", "normal": "0", "wide": "0.04em" }
