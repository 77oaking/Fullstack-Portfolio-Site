{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "../../",
    "incremental": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "scripts/**/*", "test/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/pages/themes",
    "src/pages/languages",
    "src/pages/awards",
    "src/pages/references",
    "src/pages/cv",
    "src/schema/theme.schema.ts",
    "src/schema/language.schema.ts",
    "src/schema/award.schema.ts",
    "src/schema/cv-reference.schema.ts",
    "src/schema/cv-personal.schema.ts",
    "src/schema/cv-summary.schema.ts",
    "src/schema/skill.schema.ts",
    "src/dto/theme.dto.ts",
    "src/dto/language.dto.ts",
    "src/dto/award.dto.ts",
    "src/dto/cv-reference.dto.ts",
    "src/dto/cv-personal.dto.ts",
    "src/dto/cv-summary.dto.ts",
    "src/dto/cv-import.dto.ts",
    "src/dto/skill.dto.ts"
  ]
}
