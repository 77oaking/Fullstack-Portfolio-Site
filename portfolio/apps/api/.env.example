# API
PORT=4001
NODE_ENV=development
PRODUCTION_BUILD=false

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# MongoDB
# Local: mongodb://127.0.0.1:27017/portfolio
# Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/portfolio
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Admin JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_ADMIN=replace-me-with-48-random-bytes-hex
JWT_EXPIRES_ADMIN=604800

# Seed user — used by scripts/seed.ts on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately
ADMIN_NAME=Site Owner

# Uploads (local dev). Set to S3 config in production.
UPLOAD_DIR=uploads

# SMTP (optional — for contact form email forwarding)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_FORWARD_TO=
